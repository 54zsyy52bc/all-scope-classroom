{
  "name": "preset-studio",
  "version": "1.0.0",
  "description": "课堂管理系统 · 预设编辑器（办公电脑独立应用）：班级/活动预设维护、器材字典、预设包导出/导入",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron electron/main.js",
    "test": "node test/store.test.js && node test/renderer.dom.test.js",
    "pack": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.kct.presetstudio",
    "productName": "PresetStudio",
    "files": [
      "electron/**/*",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    }
  }
}
